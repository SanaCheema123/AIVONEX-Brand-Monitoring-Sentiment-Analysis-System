# ─── AIVONEX Brand Monitoring System — Environment Configuration ───────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/brand_monitor.db

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8501
API_BASE_URL=http://localhost:8000

# ── Twitter API (optional – for live scraping) ────────────────────────────────
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Reddit API (optional) ─────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BrandMonitor/1.0

# ── NewsAPI (optional) ────────────────────────────────────────────────────────
NEWS_API_KEY=

# ── Notifications (optional) ──────────────────────────────────────────────────
ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
